# PostgreSQL. Docker Compose (`npm run db:up`) publishes 5433.
# When Docker is not running, this laptop's catalog is Homebrew Postgres on 5432.
DATABASE_URL=postgresql://trenio:trenio@localhost:5433/trenio

# Session cookies (min 32 chars in production)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# App origin for CSRF checks (no trailing slash)
APP_ORIGIN=http://trenio.local

# Public site URL (emails, reset links)
APP_URL=http://trenio.local

# Dev: log verification/reset links, SMS codes and review mail to console instead of sending
AUTH_DEV_LOG_EMAILS=true

# Journal threshold written to app_logs: debug | info | warn | error | fatal. Default info.
LOG_LEVEL=info

# Transactional mail. Production uses local Postfix sendmail, the same path as BronxGym.
# From is the public mailbox. MAIL_ENABLED=false keeps the letter in the dev console.
MAIL_ENABLED=
MAIL_FROM=Trenio <noreply@trenio.by>
SENDMAIL_PATH=/usr/sbin/sendmail
# Optional. Used only when MAIL_ENABLED=false and both values are set.
RESEND_API_KEY=

# SMS.BY. Same account as BronxGym. Sender is TRENIO.BY (id 7027) when the id is empty.
SMS_BY_ENABLED=false
SMS_BY_API_KEY=
SMS_BY_ALPHANAME_ID=7027

# Google sign-in on the email form. Web client. The secret stays on the server.
# Redirect URI is APP_URL + /auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yandex ID sign-in. Web client. The secret stays on the server.
# Redirect URI is APP_URL + /auth/yandex/callback.
# The live app registers https://trenio.by/auth/yandex/callback.
# Granted rights: email, name and surname, portrait, default phone.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Yandex Maps. The JavaScript key is public in the browser; restrict it by HTTP referrer.
# Static API stays on the server and is not called: the free tier is 100 requests a day.
# MapKit is for a native app. This site does not load it.
VITE_YANDEX_MAPS_JS_API_KEY=
YANDEX_MAPS_STATIC_API_KEY=
YANDEX_MAPS_MAPKIT_API_KEY=

# Telegram Login Widget / Mini App. Both token and username are required to enable the button.
# WEBHOOK_SECRET is the header Telegram sends to /api/telegram/webhook. Empty skips the webhook.
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_BOT_USERNAME=
VITE_TELEGRAM_LOGIN_BOT_USERNAME=
TELEGRAM_LOGIN_WEBHOOK_SECRET=

# Web Push for message notices on a phone. Generate a pair with `npx web-push generate-vapid-keys`.
# The public key is sent to the browser. The private key stays on the server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:trenioby@gmail.com

# TinyPNG / TinyJPG. Compresses JPEG, PNG, WebP, and AVIF that land on the site. Empty keeps the sharp file.
TINIFY_API_KEY=

# Laptop sync with the live site. Bearer secret for /api/sync/marks, /api/sync/trainer, and /api/sync/welcomes.
# At least 32 characters. The same value on the laptop and on the server. Never commit it.
SYNC_TOKEN=
# SYNC_ORIGIN=https://trenio.by
